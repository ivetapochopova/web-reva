# ==========================================
# BEZPEČNOSTNÍ HLAVIČKY (Security Headers)
# ==========================================
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "microphone=(), camera=(), geolocation=()"
</IfModule>

# ==========================================
# CHYBOVÁ STRÁNKA (404 Error Document)
# ==========================================
ErrorDocument 404 /404.html

# ==========================================
# REWRITE ENGINE & ČISTÉ URL (Clean URLs)
# ==========================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Přesměrování www -> bez www (pro revaharibala.cz)
    RewriteCond %{HTTP_HOST} ^www\.revaharibala\.cz$ [NC]
    RewriteRule ^(.*)$ https://revaharibala.cz/$1 [L,R=301]

    # 2. 301 Redirect z .html URL na čisté URL
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 3. Interní Rewrite z čisté URL na .html soubor (pokud existuje)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>
