# ==========================================
# BEZPEČNOSTNÍ HLAVIČKY (Security Headers)
# ==========================================
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "microphone=(), camera=(), geolocation=()"
</IfModule>

# ==========================================
# KOMPRESE (gzip) — HTML, CSS, JS, SVG, JSON, XML
# ==========================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==========================================
# CACHE V PROHLÍŽEČI (Browser caching)
# Obrázky a fonty: 1 rok. CSS a JS: 1 týden (soubory nemají verzi v názvu,
# takže změny se u návštěvníků projeví nejpozději do týdne). HTML: 1 hodina.
# ==========================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ==========================================
# CHYBOVÁ STRÁNKA (404 Error Document)
# ==========================================
ErrorDocument 404 /404.html

# ==========================================
# REWRITE ENGINE & ČISTÉ URL (Clean URLs)
# ==========================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Přesměrování www -> bez www (pro revaharibala.cz)
    RewriteCond %{HTTP_HOST} ^www\.revaharibala\.cz$ [NC]
    RewriteRule ^(.*)$ https://revaharibala.cz/$1 [L,R=301]

    # 1b. /index a /index.html -> / (úvodní stránka bez "index" v URL)
    RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # 2. 301 Redirect z .html URL na čisté URL
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 3. Interní Rewrite z čisté URL na .html soubor (pokud existuje)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>
